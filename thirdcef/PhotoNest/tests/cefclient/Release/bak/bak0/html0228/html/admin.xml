            <ul>
                <li g='dashboard'><a href="javascript:;" onclick="admin_url('./admin.html');return false;"><i class="icon-television"></i> {'Dashboard'|@translate}</a></li>
                <li g='galleries'><a href="javascript:;" onclick="admin_url('./admin.html?page=admin.galleries');return false;"><i class="icon-exchange"></i> {'Photo Directory'|@translate}{$pending_span}</a></li>
                <li g='cat_list'><a href="javascript:;" onclick="admin_url('./admin.html?page=admin.cat_list');return false;"><i class="icon-sitemap"></i> {'Albums'|@translate}</a></li>
                <li g='tags'><a href="javascript:;" onclick="admin_url('./admin.html?page=admin.tags');return false;"><i class="icon-tags"></i> {'Tags'|@translate}</a></li>
                <li g='global'><a href="javascript:;" onclick="admin_url('./admin.html?page=admin.batch&from=1&mode=global');return false;"><i class="icon-pencil"></i> {'Batch Manager'|@translate}</a></li>
                {$menubar_in_caddie} {$menubar_no_album}
                {$menubar_duplicates}
            </ul>
            <br />
            <ul>
                <li g='configuration'><a href="javascript:;" onclick="admin_url('./admin.html?page=admin.config&section=main');return false;"><i class="icon-cog"></i> {'Configuration'|@translate}</a></li>
                <li g='stats'><a href="javascript:;" onclick="admin_url('./admin.html?page=admin.stats&{yearmonth}');return false;"><i class="icon-back-in-time"></i> {'History'|@translate}</a></li>
            </ul>
        </aside>
        <script type="text/javascript">
			var storage = window.localStorage;
			if (location.href.indexOf("admin.tags") > 0) {
			}
			else{
				storage.schtag = "";
			}
			
            function admin_url(url) {
                if (url == "") {
                    if (storage.a) {
                        url = storage.a;
                    }
                    else {
                        url = "./index.html";
                    }
                }

                if (storage.b == '1') {
                    $('#aru').html("{'Are are you sure you want to leave this page?'|@translate}&nbsp; &nbsp;");
                    $('#info').attr("cmd", url);
                    $('#info').delay(100).show();
                    $('#info').delay(5000).fadeOut();
                }
                else {
                    window.location = url;
                }
            };

            function get_pending(ty) {
                if (location.href.indexOf("admin.galleries") > 0) {
                    $.get("./index.html?act=index.get_nb", function (data, state) {
                        var info = $.parseJSON(data);
                        if (info.stat == "err") {
                            location.reload();
                        }
                    });
                }
                else {
                    $.get("./index.html?act=index.get_pending&ty=" + ty, function (data, state) {
                        var info = $.parseJSON(data);
                        if (info.stat == "err") {
                            setTimeout("get_pending('0')", 700);
                        }
                        else if (info.stat == "ok") {
                            var nb = parseInt(info.nb);
                            if (nb <= 0) {
                                $("#pending").html("");
                                $("#pending").hide();
                            }
                            else {
                                $("#pending").html(info.nb);
                                $("#pending").show();
                            }
                        }
                    });
                }
            }

            function myactivate(activate) {
                if (activate == "1") {
                    if (storage.idx == "0") {

                        if (location.href.indexOf("admin.galleries") > 0) {
                            if ($("#progressbarall").is(":hidden") && !$(".selectFiles").is(":hidden")) {
                                $("#startUpload").attr("disabled", "true");
                                $("#startUpload").css("background-color", "#999");
                                setTimeout("get_pending('1')", 100);
                            }
                        }
                        else {
                            setTimeout("get_pending('1')", 100);
                        }
                    }
                }
                storage.idx = activate;
            }
        </script>  ]]>
		</templ>
	</item>
