		<templ>
			<![CDATA[<fieldset class="elementEdit">
	<legend>{$name}</legend>
	<span class="thumb">
	{$thumb}{$btn_unit_edit}
	</span>
	<table style="margin-left:50px;">
		<tr>
			<td><strong>{'Title'|@translate}</strong></td>
			<td><input type="text" class="large" name="name-{$id}" value="{$name}" maxlength="25" /></td>
		</tr>
		<tr>
			<td><strong>{'Author'|@translate}</strong></td>
			<td><input type="text" class="large" name="author-{$id}" value="{$author}" maxlength="25" /></td>
		</tr>
		<tr>
			<td><strong>{'Creation date'|@translate}</strong></td>
			<td>
  <input type="hidden" id="date_creation-{$id}" name="date_creation-{$id}" value="{$createval}" "/>
  <label>
	<i class="icon-calendar"></i>
	<input type="text" class="datep middle" data-id="date_creation-{$id}" value="{$createtime}" readonly="readonly"  maxlength="25" />
	<a id="adate_creation-{$id}" href="javascript:;" style="display:none;" onclick="reset(this); return false;" data-value="{$createval}" data-show="{$createtime}">{'unset'|@translate}</a>
  </label>
		  </td>
		</tr>
		<tr>
			<td><strong>{'Tag'|@translate}</strong></td>
			<td>
				<select data-selectize="tags" data-value="[{$tag_value}]"
						placeholder="{'Type in a search term'|@translate}"
						data-create="true" name="tags-{$id}" multiple style="width:500px;"></select>
			</td>
		</tr>
		<tr>
			<td><strong>{'Description'|@translate}</strong></td>
			<td><textarea cols="50" rows="3" name="description-{$id}" id="description-{$id}" class="description">{$comment}</textarea></td>
		</tr>
	</table>
</fieldset>]]>
