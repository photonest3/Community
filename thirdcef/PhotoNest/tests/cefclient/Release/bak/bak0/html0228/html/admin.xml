		<id>admin_menubar</id>
		<templ>
			<![CDATA[<aside>
            <ul>
                <li>
                    <a href="javascript:;" onclick="admin_url('');return false;" style="display:inline-block;" title="{'Go back'|@translate}"><span class="home"><i class="icon-left-open"></i>{'Visit the gallery'|@translate}</span></a>
