<tr><td class="detail_td1"><a id="btnexif" href="javascript:;" onclick="show_details(this);return false;" class="detail_td_name" style="float:right;right:0;opacity100;" ><i class="icon-down-open"></i></a></td></tr>
<tr><td class="detail_td1"><table id="tbexif">]]>
