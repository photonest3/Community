Name: "{group}\{#MyAppNameZh}"; Filename: "{app}\bin\nest2.exe"

[Run]
Filename: "{app}\bin\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
;Type: files; Name: "{localappdata}\PhotoNest\Encryption\prof.ini"

[UninstallRun]
;Filename: "{app}\bin\inscl.exe"; Parameters: "encryption"; WorkingDir: "{app}"; RunOnceId: "inscl"

[Code]
// for dll
function ShowLangDialog(hWnd: Integer; ty: Integer; lpText: String): Integer; external 'ShowLangDialog@files:ins.dll stdcall setuponly';
function SelectLangIni(ty: Integer; lpText: String): Integer; external 'SelectLangIni@files:ins.dll stdcall setuponly';
function GetDriveType(lpRootPathName:AnsiString): Longint; external 'GetDriveTypeA@kernel32.dll stdcall';

var bExist: Boolean;
	uicmd: String;
	finished: String;

function GetDefaultInstallRoot(Param: String): String; 
var s: String; 
	nn:Integer;
begin  
	if (bExist = true) then begin
		s:=uicmd;
		StringChange(s, '\unins000.exe', '');  
		StringChange(s, '"', ''); 
		Result := s;	
	end else begin	
		nn:=GetDriveType('D:/');
		//DRIVE_FIXED 3
		if(nn=3)then begin
       Result := ExpandConstant('{commonpf64}\PhotoNest\Nest2');
		end else begin
       Result := ExpandConstant('{commonpf64}\PhotoNest\Nest2');
		end
	end;
end;  

function InitializeSetup(): Boolean;
var Language: string;
	ret: Integer; 
	appWnd: HWND;
begin
	finished := '';
	Language := ExpandConstant('{param:LANG}');
	bExist := RegQueryStringValue(HKEY_LOCAL_MACHINE, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PhotoNest Encryption_is1', 'UninstallString', uicmd);
	if (bExist = True) then begin
		if Language = '' then begin
			SelectLangIni(2, ExpandConstant('{srcexe}'));
			Result := False;
			Exit;
		end else begin
			result := True;
		end;
	end else begin
		if Language = '' then begin
			appWnd :=  FindWindowByWindowName('Setup');
			ret:= ShowLangDialog(appWnd, 2, ExpandConstant('{srcexe}'));
			Result := False;
			Exit;
		end else begin
			Result := True;  
		end;
	end;		
end;
  
procedure DeinitializeSetup();
var
	FileName: String;
	s5: String;
	b:Boolean;
begin
	if finished = '1' then begin
		FileName:=ExpandConstant('{app}');
		s5 := FileName + '\sample';
		b := False;//DirExists(s5);
		if b = False then begin
			//MsgBox(s5, mbInformation, mb_Ok);
		end;
	end;
end;
  
procedure CurPageChanged(CurPageID: Integer);
begin
	if CurPageID = wpReady then begin
		if (bExist = True) then begin
			WizardForm.NextButton.Caption := CustomMessage('ButtonInstall');
			WizardForm.NextButton.Width := WizardForm.NextButton.Width+ScaleX(10);
			WizardForm.ReadyLabel.Caption := CustomMessage('ReadyLabel2b');
		end;
	end else if CurPageID = wpFinished then begin
		finished := '1';
	end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var ErrorCode: Integer;
begin
	if CurPageID = wpReady then begin
		if (bExist = True) then begin
			ShellExec('open','taskkill.exe','/f /im {#MyAppExeName}','',SW_HIDE,ewWaitUntilTerminated,ErrorCode);
		end;
	end;
	Result := True;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
	if PageID = wpSelectTasks then begin
		if (bExist = True) then begin
			Result := True;
		end;
	end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var ErrorCode: Integer;
	szResponse: String;
	szCode: String;
	appWnd: HWND;
begin
	if CurUninstallStep = usAppMutexCheck then begin
		ShellExec('open','taskkill.exe','/f /im {#MyAppExeName}','',SW_HIDE,ewWaitUntilTerminated,ErrorCode);
		szResponse:=ExpandConstant('{app}\bin\inscl.exe');
		appWnd :=  FindWindowByWindowName('Uninstall');
		ShellExec('open',szResponse,IntToStr(appWnd) + ' decryption','',SW_SHOW,ewWaitUntilTerminated,ErrorCode);
		if ErrorCode=200 then begin   
			Abort;
		end else begin
		
			//SetIniString('section', 'language', '', ExpandConstant('{localappdata}\PhotoNest\Encryption\prof.ini'));
//			RegQueryStringValue(HKEY_CURRENT_USER, 'SOFTWARE\OpenCV\HighGUI\Windows\ZK3', 'wo3', szCode);
//			if (szCode <> '') then begin
//				RegDeleteValue(HKEY_CURRENT_USER, 'SOFTWARE\OpenCV\HighGUI\Windows\ZK3', 'wo3');
//				RegDeleteValue(HKEY_LOCAL_MACHINE, 'SOFTWARE\PhotoNest\Encryption', 'i3');
//			end;
		end; 
	end;
end;