[Tasks]
;Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkedonce


[Registry]
; Start "Software\My Company\My Program" keys under HKEY_CURRENT_USER
; and HKEY_LOCAL_MACHINE. The flags tell it to always delete the
; "My Program" keys upon uninstall, and delete the "My Company" keys
; if there is nothing left in them.

Root: HKCR; Subkey: ".jpg\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".jpeg\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".png\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".bmp\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".dib\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".gif\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".mp3\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".mp4\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCR; Subkey: ".webp\OpenWithProgids"; ValueType: string; ValueName: "PhotoNest.vr2"; ValueData: ""; Flags: uninsdeletevalue


Root: HKCR; Subkey: "PhotoNest.vr2"; Flags: uninsdeletekey
Root: HKCR; Subkey: "PhotoNest.vr2\shell"; Flags: uninsdeletekey
Root: HKCR; Subkey: "PhotoNest.vr2\DefaultIcon"; ValueType: string; ValueData: "{app}\bin\nest2.exe,-2"; Flags: uninsdeletekey
Root: HKCR; Subkey: "PhotoNest.vr2\shell\open"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "PhotoNest Viewer2"; Flags: uninsdeletekey
Root: HKCR; Subkey: "PhotoNest.vr2\shell\open\command"; ValueType: string; ValueData: """{app}\bin\nest2.exe"" ""%1"""; Flags: uninsdeletekey

